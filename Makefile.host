# Desktop build (Linux/macOS/MSYS2) for development and testing.
#
#   make -f Makefile.host            # ./jetsetwilly (SDL2)
#   make -f Makefile.host difftest   # comparison test against the original Z80 code
#   make -f Makefile.host test       # run it (needs "Data files/JetSetWilly.tzx")

CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra
SDL_CFLAGS := $(shell pkg-config --cflags sdl2 2>/dev/null || sdl2-config --cflags)
SDL_LIBS   := $(shell pkg-config --libs sdl2 2>/dev/null || sdl2-config --libs)

GAME_SRCS = src/jsw.c src/jsw_code.c src/z80c_glue.c src/tape.c src/zx.c src/zx_font.c
GAME128_SRCS = src/jsw128.c src/jsw128_code.c src/z80c_glue.c src/tape.c src/zx.c
HDRS = src/*.h

all: jetsetwilly jetsetwilly128 jetsetwillyx

jetsetwillyx: src/main.c $(GAME_SRCS) src/jsw128.c src/jsw128_code.c src/ay.c $(HDRS)
	$(CC) $(CFLAGS) -DJSW_COMBINED $(SDL_CFLAGS) -o $@ src/main.c $(GAME_SRCS) src/jsw128.c src/jsw128_code.c src/ay.c $(SDL_LIBS)

jetsetwilly128: src/main.c $(GAME128_SRCS) src/zx_font.c src/ay.c $(HDRS)
	$(CC) $(CFLAGS) -DJSW_ONLY_128 $(SDL_CFLAGS) -o $@ src/main.c $(GAME128_SRCS) src/zx_font.c src/ay.c $(SDL_LIBS)

jetsetwilly: src/main.c $(GAME_SRCS) $(HDRS)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -o $@ src/main.c $(GAME_SRCS) $(SDL_LIBS)

difftest: tools/difftest.c $(GAME_SRCS) tools/z80ref/z80.c $(HDRS)
	$(CC) $(CFLAGS) -Wno-unused-parameter -o $@ tools/difftest.c $(GAME_SRCS) tools/z80ref/z80.c

difftest128: tools/difftest128.c $(GAME128_SRCS) tools/z80ref/z80.c $(HDRS)
	$(CC) $(CFLAGS) -Wno-unused-parameter -o difftest128 tools/difftest128.c src/jsw128.c src/tape.c src/zx.c tools/z80ref/z80.c
	$(CC) $(CFLAGS) -Wno-unused-parameter -DPORT -DZ80C_VERIFY -o difftest128p tools/difftest128.c $(GAME128_SRCS) tools/z80ref/z80.c

test: difftest difftest128
	./tools/run_difftest.sh
	./tools/run_difftest128.sh

clean:
	rm -f jetsetwilly jetsetwilly128 jetsetwillyx difftest difftest128 difftest128p

.PHONY: all test clean
